{
    "name": "bayarcash/php-demo",
    "description": "Vanilla PHP demo of the Bayarcash payment gateway, built on bayarcash/php-sdk",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "bayarcash/php-sdk": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "BayarcashDemo\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
